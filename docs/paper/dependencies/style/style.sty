% ============================================================
% LINE SPACING
% ============================================================
\setstretch{1.15} % professional line spacing for readability

% ============================================================
% CHAPTER HEADINGS (titlesec)
% ============================================================
\titleformat{\chapter}[display]
  {\normalfont\Large\bfseries\color{chaptercolor}}     % format
  {\chaptertitlename\ \thechapter}                      % label
  {8pt}                                                 % sep between label and title
  {\huge}                                               % before-code
  [\vspace{4pt}{\titlerule[0.8pt]}]                     % after-code: rule below title

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\Large\bfseries\color{chaptercolor}}     % format for unnumbered chapters
  {}                                                    % no label
  {0pt}                                                 % sep
  {\huge}                                               % before-code
  [\vspace{4pt}{\titlerule[0.8pt]}]                     % after-code

\titlespacing*{\chapter}{0pt}{-20pt}{30pt}  % left, before, after

% section styling
\titleformat{\section}
  {\normalfont\large\bfseries\color{chaptercolor}}
  {\thesection}{0.7em}{}

\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{0.7em}{}

\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}
  {\thesubsubsection}{0.7em}{}

% ============================================================
% WIDOW/ORPHAN CONTROL — prevent single lines at page top/bottom
% ============================================================
\widowpenalty=10000
\clubpenalty=10000

% ============================================================
% PAGE LAYOUT — HEADERS & FOOTERS
% ============================================================
\setlength{\headheight}{15pt}

% redefine marks BEFORE pagestyle so they take effect
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}

% main page style for content
\fancypagestyle{main}{%
  \fancyhf{}%
  \fancyhead[L]{\small\nouppercase{\leftmark}}%
  \fancyhead[R]{\small\nouppercase{\rightmark}}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% plain pages (chapter openings, TOC, etc.) — page number only
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\pagestyle{main}

