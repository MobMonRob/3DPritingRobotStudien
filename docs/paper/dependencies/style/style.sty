    target_compile_options, target_sources, target_link_options,
    install, export, configure_file, file, list, string, math,
    FetchContent_Declare, FetchContent_MakeAvailable,
    FetchContent_GetProperties, FetchContent_Populate,
    enable_testing, get_filename_component, get_target_property,
    set_target_properties, set_property
